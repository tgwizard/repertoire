{
  "name": "repertoire",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm run typecheck && cf build",
    "preview": "npm run build && vite preview",
    "deploy": "node crawler/check-deploy.ts && npm run typecheck && cf deploy",
    "deploy:dry-run": "npm run typecheck && cf deploy --dry-run",
    "logs": "cf o11y telemetry live-tail",
    "typecheck": "tsc -b",
    "test": "node --test 'src/**/*.test.ts' 'crawler/**/*.test.ts' 'worker/**/*.test.ts'",
    "test:data": "node --test 'test/data/*.test.ts'",
    "test:e2e": "playwright test",
    "smoke": "DATA_URL=${SMOKE_URL:-https://repertoire.tgwizard.com} node --test smoke/smoke.test.ts test/data/repertoire.test.ts",
    "crawl": "node crawler/main.ts",
    "index": "node crawler/main.ts build && node crawler/local.ts",
    "data:local": "node crawler/local.ts",
    "data:publish": "node crawler/publish.ts",
    "data:pull": "node crawler/pull.ts",
    "data:refresh": "npm run crawl && npm run test:data && npm run data:publish",
    "smoke:e2e": "E2E_URL=${SMOKE_URL:-https://repertoire.tgwizard.com} playwright test",
    "test:all": "npm test && npm run test:data && npm run test:e2e",
    "dev:remote": "cf dev --mode remote"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
